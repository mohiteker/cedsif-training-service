    <!--lab1 - principal training project building -->
    <build>
        <plugins>
            <!-- mvn tomcat7:deploy | its used to deploy over remote tomcat server -->
            <!-- mvn tomcat7:run | its used to deploy over embbebed tomcat server -->
            <!-- https://stackoverflow.com/questions/26883836/tomcat-8-maven-plugin-for-java-8 -->
            <plugin>
                <groupId>org.apache.tomcat.maven</groupId>
                <artifactId>tomcat7-maven-plugin</artifactId>
                <version>2.2</version>
                <configuration>
                    <url>http://0.0.0.0:8089/manager/text</url>
                    <server>tomcat-da</server>
                    <path>/trainee26xxdemo210</path>
                    <port>8080</port>
                </configuration>
            </plugin>

        </plugins>
    </build>

    <!-- labName -->
    <name>trainee26XXdemo210-appsecurity-lab1</name>

